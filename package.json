{
  "name": "moviematch",
  "private": true,
  "version": "1.0.0",
  "description": "A cozy, swipe-to-match movie night app for two.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "deploy": "node scripts/deploy.mjs",
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "wrangler dev --port 8787",
    "dev:web": "vite",
    "preview": "npm run build && wrangler dev --port 8787",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx server/logic.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.1.0",
    "@fontsource/bungee": "^5.1.0",
    "@fontsource/vt323": "^5.1.0",
    "@tanstack/react-query": "5.59.20",
    "framer-motion": "11.11.17",
    "hono": "^4.13.13",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "concurrently": "9.1.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "wrangler": "^4.149.0"
  }
}
