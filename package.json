{
  "name": "moviematch",
  "private": true,
  "version": "1.0.0",
  "description": "A cozy, swipe-to-match movie night app for two.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "go": "npm install && npm run build && npm start",
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx server/logic.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.1.0",
    "@fontsource/instrument-serif": "5.1.0",
    "@tanstack/react-query": "5.59.20",
    "express": "4.21.1",
    "framer-motion": "11.11.17",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "tsx": "4.19.2"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "concurrently": "9.1.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
