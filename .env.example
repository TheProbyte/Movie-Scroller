# TMDB credentials (https://www.themoviedb.org/settings/api). Either one works.
# You can also paste the key into the app's setup screen instead.
TMDB_API_KEY=
TMDB_READ_TOKEN=

# Optional household passcode. When set, each phone must enter it once.
APP_PASSCODE=

# Where the SQLite database lives (default ./data/moviematch.db)
DATA_DIR=./data
PORT=8787
